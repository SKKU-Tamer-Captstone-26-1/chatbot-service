# Operator-local Cloud Build substitutions template.
# Copy to deploy/gcp/staging.substitutions.env and fill from Terraform outputs
# and Secret Manager version numbers. The filled file is ignored by git.

PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
REGION=asia-northeast3
REPOSITORY=REPLACE_WITH_ARTIFACT_REGISTRY_REPOSITORY
SERVICE_NAME=ai-chatbot-service-staging
MIGRATION_JOB_NAME=ai-chatbot-service-migrate-staging
CHATBOT_STAGING_SERVICE_ACCOUNT=REPLACE_WITH_CLOUD_RUN_SERVICE_ACCOUNT_EMAIL
CLOUD_SQL_CONNECTION_NAME=REPLACE_WITH_CLOUD_SQL_CONNECTION_NAME
SERVERLESS_VPC_CONNECTOR=REPLACE_WITH_SERVERLESS_VPC_CONNECTOR_NAME
DB_DSN_SECRET_VERSION=REPLACE_WITH_PINNED_SECRET_VERSION
REDIS_URL_SECRET_VERSION=REPLACE_WITH_PINNED_SECRET_VERSION
HF_TOKEN_SECRET_VERSION=REPLACE_WITH_PINNED_SECRET_VERSION
