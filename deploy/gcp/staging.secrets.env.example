# Operator-local staging secret values template.
# Copy to deploy/gcp/staging.secrets.env and fill after Terraform creates the
# Secret Manager secret containers. The filled file is ignored by git.

PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
CHATBOT_DB_DSN=postgres://USER:PASSWORD@/chatbot_service?host=/cloudsql/PROJECT:REGION:INSTANCE
CHATBOT_CACHE_REDIS_URL=redis://REPLACE_WITH_REDIS_HOST:6379/0
HF_TOKEN=REPLACE_WITH_HUGGING_FACE_TOKEN
CHATBOT_VALIDATION_AUTHORIZATION="Bearer REPLACE_WITH_STAGING_VALIDATION_TOKEN"
