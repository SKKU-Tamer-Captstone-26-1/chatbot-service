# Operator-local staging validation template.
# Copy outside git or export manually. Do not commit filled values.

CHATBOT_VALIDATION_TARGET=REPLACE_WITH_STAGING_GATEWAY_HOST:443
CHATBOT_VALIDATION_SECURE=true
CHATBOT_VALIDATION_USER_ID=validation-user
CHATBOT_VALIDATION_AUTHORIZATION="Bearer REPLACE_WITH_STAGING_TOKEN"
CHATBOT_VALIDATION_TIMEOUT_SEC=15
CHATBOT_VALIDATION_CONCURRENCY=500
CHATBOT_VALIDATION_REQUESTS=500
CHATBOT_VALIDATION_P95_THRESHOLD_MS=5000
CHATBOT_VALIDATION_CACHE_WARMUP_MIN_IMPROVEMENT_RATIO=-1
CHATBOT_VALIDATION_REQUIRE_RUNTIME_PREFLIGHT=true
CHATBOT_VALIDATION_REQUIRE_AUTHORIZATION=true
CHATBOT_VALIDATION_REQUIRE_REDIS_PREFLIGHT=true
CHATBOT_VALIDATION_SELECTED_BEVERAGE_ID=REPLACE_WITH_STAGING_BEVERAGE_ID
CHATBOT_VALIDATION_LAT=37.5665
CHATBOT_VALIDATION_LNG=126.9780
CHATBOT_VALIDATION_RADIUS_M=1500

RECOMMENDATION_SERVICE_URL=REPLACE_WITH_RECOMMENDATION_GRPC_TARGET
CHATBOT_CACHE_BACKEND=redis
CHATBOT_CACHE_REDIS_URL=redis://REPLACE_WITH_REDIS_HOST:6379/0
CHATBOT_STORE_CONVERSATIONS=true
CHATBOT_DB_DSN=postgres://REPLACE_WITH_OPERATOR_LOCAL_STAGING_DSN
CHATBOT_LLM_PROVIDER=huggingface_tgi
CHATBOT_LLM_ENDPOINT_URL=REPLACE_WITH_OPENAI_COMPATIBLE_CHAT_COMPLETIONS_URL
CHATBOT_LLM_MODEL=REPLACE_WITH_STAGING_MODEL
CHATBOT_LLM_AUTH_MODE=bearer_env
CHATBOT_LLM_API_KEY_ENV=HF_TOKEN
HF_TOKEN=REPLACE_WITH_OPERATOR_LOCAL_TOKEN
