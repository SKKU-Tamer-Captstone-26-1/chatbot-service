# AI Chatbot Service
CHATBOT_SERVICE_ADDR=:9100
# Cloud Run sets PORT automatically. If CHATBOT_SERVICE_ADDR is unset, the
# service listens on :$PORT and falls back to :9100 locally.
CHATBOT_AUTH_MODE=validate_token
CHATBOT_AUTH_USER_ID_METADATA_KEY=x-user-id
CHATBOT_AUTH_AUTHORIZATION_METADATA_KEY=authorization

# gRPC dependencies
AUTH_SERVICE_URL=https://authorization-service-44649239380.asia-northeast3.run.app
RECOMMENDATION_SERVICE_GRPC_ADDR=recommendation-service-44649239380.asia-northeast3.run.app:443
RECOMMENDATION_SERVICE_GRPC_TLS=true
RECOMMENDATION_SERVICE_SERVERLESS_AUTH_MODE=google_id_token
RECOMMENDATION_SERVICE_SERVERLESS_AUDIENCE=https://recommendation-service-44649239380.asia-northeast3.run.app
RECOMMENDATION_SERVICE_SERVERLESS_TOKEN_ENV=GOOGLE_ID_TOKEN
# Legacy fallback only. Prefer RECOMMENDATION_SERVICE_GRPC_ADDR for gRPC clients.
RECOMMENDATION_SERVICE_URL=
MAP_SERVICE_URL=REPLACE_WITH_MAP_SERVICE_URL

# LLM provider.
# The adapter calls an OpenAI-compatible /v1/chat/completions endpoint.
# If CHATBOT_LLM_PROVIDER is omitted but CHATBOT_LLM_ENDPOINT_URL is set, the
# service uses huggingface_tgi automatically.
CHATBOT_LLM_PROVIDER=huggingface_tgi
CHATBOT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
CHATBOT_LLM_ENDPOINT_URL=https://REPLACE_WITH_LLM_CLOUD_RUN_URL/v1/chat/completions
CHATBOT_LLM_AUTH_MODE=none
CHATBOT_LLM_SERVERLESS_AUTH_MODE=google_id_token
CHATBOT_LLM_SERVERLESS_AUDIENCE=https://REPLACE_WITH_LLM_CLOUD_RUN_URL
CHATBOT_LLM_SERVERLESS_TOKEN_ENV=GOOGLE_ID_TOKEN
# Optional for protected Hugging Face/TGI endpoints:
# CHATBOT_LLM_AUTH_MODE=bearer_env
CHATBOT_LLM_API_KEY_ENV=HF_TOKEN
CHATBOT_LLM_TIMEOUT_MS=8000
CHATBOT_LLM_TEMPERATURE=0.2
CHATBOT_LLM_MAX_TOKENS=512

# Guardrails
CHATBOT_DEFAULT_LANGUAGE=ko
CHATBOT_MAX_RETRIEVED_CANDIDATES=5
CHATBOT_MIN_CONFIDENCE=0.55
CHATBOT_REQUIRE_GROUNDED_FACTS=true

# Cache and scaling.
# Use redis for production Memorystore/Redis. memory is process-local and is
# intended for local development or single-process tests.
CHATBOT_CACHE_BACKEND=redis
CHATBOT_CACHE_REDIS_URL=redis://localhost:6379/0
CHATBOT_CACHE_PROFILE_STATUS_TTL_SEC=300
CHATBOT_CACHE_BEVERAGE_RECOMMENDATIONS_TTL_SEC=300
CHATBOT_CACHE_VENUE_RECOMMENDATIONS_TTL_SEC=120
CHATBOT_CACHE_PROMPT_CONTEXT_TTL_SEC=120
CHATBOT_CACHE_LOCATION_BUCKET_PRECISION=3

# Conversation storage
CHATBOT_STORE_CONVERSATIONS=true
CHATBOT_DB_DSN=postgres://chatbot_user:chatbot_pass@localhost:55433/chatbot_service?sslmode=disable
CHATBOT_STORAGE_RETENTION_DAYS=365
CHATBOT_ASYNC_CONVERSATION_PERSISTENCE=true
CHATBOT_PERSISTENCE_QUEUE_MAX_SIZE=1000
CHATBOT_PERSISTENCE_RETRY_ATTEMPTS=3
CHATBOT_METRICS_SNAPSHOT_PATH=/tmp/chatbot-service-metrics.json

# Staging validation. Do not commit real tokens.
CHATBOT_VALIDATION_TARGET=localhost:9100
CHATBOT_VALIDATION_SECURE=false
CHATBOT_VALIDATION_USER_ID=validation-user
CHATBOT_VALIDATION_AUTHORIZATION=Bearer REPLACE_WITH_TEST_TOKEN
CHATBOT_VALIDATION_TIMEOUT_SEC=15
CHATBOT_VALIDATION_CONCURRENCY=500
CHATBOT_VALIDATION_REQUESTS=500
CHATBOT_VALIDATION_P95_THRESHOLD_MS=5000
CHATBOT_VALIDATION_CACHE_WARMUP_MIN_IMPROVEMENT_RATIO=-1
CHATBOT_VALIDATION_REQUIRE_RUNTIME_PREFLIGHT=true
CHATBOT_VALIDATION_REQUIRE_AUTHORIZATION=true
CHATBOT_VALIDATION_REQUIRE_REDIS_PREFLIGHT=true
CHATBOT_VALIDATION_SERVICE_METRICS_PATH=/tmp/chatbot-service-metrics.json
CHATBOT_VALIDATION_SELECTED_BEVERAGE_ID=bev_1
CHATBOT_VALIDATION_LAT=37.5665
CHATBOT_VALIDATION_LNG=126.9780
CHATBOT_VALIDATION_RADIUS_M=1500
