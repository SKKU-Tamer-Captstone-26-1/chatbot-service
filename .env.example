# AI Assistant Service
ASSISTANT_SERVICE_ADDR=:9100
ASSISTANT_AUTH_MODE=validate_token

# gRPC dependencies
AUTH_SERVICE_URL=https://authorization-service-44649239380.asia-northeast3.run.app
RECOMMENDATION_SERVICE_URL=REPLACE_WITH_RECOMMENDATION_SERVICE_URL
MAP_SERVICE_URL=REPLACE_WITH_MAP_SERVICE_URL

# LLM provider is intentionally undecided.
# Examples: openai_compatible, local_vllm, ollama, llamacpp, none
ASSISTANT_LLM_PROVIDER=none
ASSISTANT_LLM_MODEL=REPLACE_ME
ASSISTANT_LLM_TIMEOUT_MS=8000
ASSISTANT_LLM_TEMPERATURE=0.2

# Guardrails
ASSISTANT_DEFAULT_LANGUAGE=ko
ASSISTANT_MAX_RETRIEVED_CANDIDATES=5
ASSISTANT_MIN_CONFIDENCE=0.55
ASSISTANT_REQUIRE_GROUNDED_FACTS=true

# Conversation storage
ASSISTANT_STORE_CONVERSATIONS=true
ASSISTANT_DB_DSN=postgres://assistant_user:assistant_pass@localhost:55433/assistant_service?sslmode=disable
