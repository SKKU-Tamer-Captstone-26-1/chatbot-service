# AI Chatbot Service
CHATBOT_SERVICE_ADDR=:9100
CHATBOT_AUTH_MODE=validate_token
CHATBOT_AUTH_USER_ID_METADATA_KEY=x-user-id
CHATBOT_AUTH_AUTHORIZATION_METADATA_KEY=authorization

# gRPC dependencies
AUTH_SERVICE_URL=https://authorization-service-44649239380.asia-northeast3.run.app
RECOMMENDATION_SERVICE_URL=REPLACE_WITH_RECOMMENDATION_SERVICE_URL
MAP_SERVICE_URL=REPLACE_WITH_MAP_SERVICE_URL

# LLM provider.
# Use huggingface_tgi for Hugging Face Inference Endpoints or TGI-compatible
# deployments that expose /v1/chat/completions.
CHATBOT_LLM_PROVIDER=huggingface_tgi
CHATBOT_LLM_MODEL=REPLACE_ME
CHATBOT_LLM_ENDPOINT_URL=https://REPLACE_WITH_HF_ENDPOINT/v1/chat/completions
CHATBOT_LLM_API_KEY_ENV=HF_TOKEN
CHATBOT_LLM_TIMEOUT_MS=8000
CHATBOT_LLM_TEMPERATURE=0.2
CHATBOT_LLM_MAX_TOKENS=512

# Guardrails
CHATBOT_DEFAULT_LANGUAGE=ko
CHATBOT_MAX_RETRIEVED_CANDIDATES=5
CHATBOT_MIN_CONFIDENCE=0.55
CHATBOT_REQUIRE_GROUNDED_FACTS=true

# Cache and scaling.
# Use redis for production Memorystore/Redis. memory is process-local and is
# intended for local development or single-process tests.
CHATBOT_CACHE_BACKEND=redis
CHATBOT_CACHE_REDIS_URL=redis://localhost:6379/0
CHATBOT_CACHE_PROFILE_STATUS_TTL_SEC=300
CHATBOT_CACHE_BEVERAGE_RECOMMENDATIONS_TTL_SEC=300
CHATBOT_CACHE_VENUE_RECOMMENDATIONS_TTL_SEC=120
CHATBOT_CACHE_PROMPT_CONTEXT_TTL_SEC=120
CHATBOT_CACHE_LOCATION_BUCKET_PRECISION=3

# Conversation storage
CHATBOT_STORE_CONVERSATIONS=true
CHATBOT_DB_DSN=postgres://chatbot_user:chatbot_pass@localhost:55433/chatbot_service?sslmode=disable
CHATBOT_STORAGE_RETENTION_DAYS=365
CHATBOT_ASYNC_CONVERSATION_PERSISTENCE=true
CHATBOT_PERSISTENCE_QUEUE_MAX_SIZE=1000
CHATBOT_PERSISTENCE_RETRY_ATTEMPTS=3
